# RegulaRAG Indonesia — Environment Variables Example
# Salin file ini menjadi .env jika ingin mengubah konfigurasi default tanpa mengubah kode.

# Model Embedding (default: intfloat/multilingual-e5-base)
# Opsi fallback hemat memori: intfloat/multilingual-e5-small
REGULARAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Model Generator Ollama (default: qwen3:1.7b-q4_K_M)
OLLAMA_MODEL=qwen3:1.7b-q4_K_M

# Ukuran context window Ollama (default: 4096)
OLLAMA_NUM_CTX=4096

# URL endpoint Ollama lokal (default: http://127.0.0.1:11434/api/chat)
OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Mode offline Hugging Face (1 = jangan hubungi internet jika model sudah di cache lokal)
HF_HUB_OFFLINE=0

# LLM memakai pengaturan otomatis Ollama; override CPU opsional
# OLLAMA_NUM_GPU=0
